    {
      "cell_type": "markdown",
      "source": [
        " STEP 19 — Test the Model's Accuracy"
      ],
      "metadata": {
        "id": "teOtKwfnr4ck"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.metrics import accuracy_score\n",
        "\n",
        "# Model se test data pe prediction karwayi\n",
        "y_pred = model.predict(X_test)\n",
        "\n",
        "# Accuracy check ki\n",
        "accuracy = accuracy_score(y_test, y_pred)\n",
        "\n",
        "print(\"Model Accuracy:\", round(accuracy * 100, 2), \"%\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "twYvukBpr9cM",
