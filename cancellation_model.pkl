  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "STEP 1 — Libraries Import"
      ],
      "metadata": {
        "id": "XgHfDoHakMPQ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "print(\"Libraries loaded!\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "OS_LWk3EkrJr",
        "outputId": "b2519303-4c6e-45a7-d74c-7434e50d2599"
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Libraries loaded!\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "STEP 2 — Set a Random Seed"
      ],
      "metadata": {
        "id": "JrcndHt4kxRQ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "np.random.seed(42)\n",
        "\n",
        "n = 100\n",
        "\n",
        "print(\"Seed set!\")\n",
        "print(\"Total orders:\", n)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "sf-g3pJhk33P",
        "outputId": "4b2cecc8-58a5-431d-fb0b-d9e8e9228847"
      },
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Seed set!\n",
            "Total orders: 100\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "STEP 3 — Create the City List"
      ],
      "metadata": {
        "id": "xWxT89EXk6vv"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "cities = [\"Karachi\", \"Lahore\", \"Islamabad\", \"Rawalpindi\", \"Kahuta\", \"Faisalabad\", \"Multan\", \"Peshawar\"]\n",
        "\n",
        "print(\"City list created!\")\n",
        "print(cities)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "K3SAPQopk_UV",
        "outputId": "5ee07f76-dacc-4f68-afff-88aa59e501b0"
      },
      "execution_count": 6,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "City list created!\n",
            "['Karachi', 'Lahore', 'Islamabad', 'Rawalpindi', 'Kahuta', 'Faisalabad', 'Multan', 'Peshawar']\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "STEP 4 — Create 100 Fake Orders"
      ],
      "metadata": {
        "id": "-EVe5FqqlDoS"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "data = {\n",
        "    \"order_id\": [f\"ORD{i:03d}\" for i in range(1, n + 1)],\n",
        "    \"city\": np.random.choice(cities, n),\n",
        "    \"order_value\": np.random.randint(500, 15000, n),\n",
        "    \"customer_age_days\": np.random.randint(1, 365, n),\n",
        "    \"num_items\": np.random.randint(1, 6, n),\n",
        "    \"is_cancelled\": np.random.choice([0, 1], n, p=[0.7, 0.3])\n",
        "}\n",
        "\n",
        "print(\"100 orders created!\")\n",
        "print(\"Data size:\", len(data[\"order_id\"]))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "VyOW21AplI76",
        "outputId": "8d2855ae-ab9e-4aa2-8e9c-b76e4934d60e"
      },
      "execution_count": 7,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "100 orders created!\n",
            "Data size: 100\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        " STEP 5 — Convert Data into a Table (DataFrame)"
      ],
      "metadata": {
        "id": "tQR3fJWelO8f"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(\"DataFrame created!\")\n",
        "print(\"Rows and Columns:\", df.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "64emKFx7lWlQ",
        "outputId": "54618000-8f39-40b2-aed5-1c76685739b7"
      },
      "execution_count": 8,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "DataFrame created!\n",
            "Rows and Columns: (100, 6)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "STEP 6 — Save the Data and Preview It"
      ],
      "metadata": {
        "id": "QsiEMOEolfaK"
