    {
      "cell_type": "markdown",
      "source": [
        "STEP 21 — Let's Fix It (Adding More Data)"
      ],
      "metadata": {
        "id": "ub5cN-unuBe5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# 1. Generate 1000 orders\n",
        "n = 1000\n",
        "cities = [\"Karachi\", \"Lahore\", \"Islamabad\", \"Rawalpindi\", \"Kahuta\", \"Faisalabad\", \"Multan\", \"Peshawar\"]\n",
        "\n",
        "data_big = {\n",
        "    \"order_id\": [f\"ORD{i:04d}\" for i in range(1, n + 1)],\n",
        "    \"city\": np.random.choice(cities, n),\n",
        "    \"order_value\": np.random.randint(500, 15000, n),\n",
        "    \"customer_age_days\": np.random.randint(1, 365, n),\n",
        "    \"num_items\": np.random.randint(1, 6, n),\n",
        "    \"delivery_days\": np.random.randint(1, 11, n)\n",
        "}\n",
        "\n",
        "df_big = pd.DataFrame(data_big)\n",
        "\n",
        "# 2. Apply your \"Late Delivery\" rule to create the target\n",
        "df_big[\"is_cancelled\"] = 0\n",
        "for i in range(n):\n",
        "    if df_big.loc[i, \"delivery_days\"] > 6:\n",
        "        df_big.loc[i, \"is_cancelled\"] = np.random.choice([0, 1], p=[0.2, 0.8])\n",
        "    elif df_big.loc[i, \"delivery_days\"] > 3:\n",
        "        df_big.loc[i, \"is_cancelled\"] = np.random.choice([0, 1], p=[0.6, 0.4])\n",
        "    else:\n",
        "        df_big.loc[i, \"is_cancelled\"] = np.random.choice([0, 1], p=[0.9, 0.1])\n",
        "\n",
        "# 3. Encode, Split, Train\n",
        "df_big_encoded = pd.get_dummies(df_big, columns=[\"city\"], dtype=int).drop(columns=[\"order_id\"])\n",
        "X_big = df_big_encoded.drop(columns=[\"is_cancelled\"])\n",
        "y_big = df_big_encoded[\"is_cancelled\"]\n",
        "\n",
        "X_train_big, X_test_big, y_train_big, y_test_big = train_test_split(X_big, y_big, test_size=0.2, random_state=42)\n",
        "\n",
        "model_big = RandomForestClassifier(random_state=42)\n",
        "model_big.fit(X_train_big, y_train_big)\n",
        "\n",
        "# 4. New Accuracy\n",
        "y_pred_big = model_big.predict(X_test_big)\n",
        "new_accuracy = accuracy_score(y_test_big, y_pred_big)\n",
        "\n",
        "print(\"Model retrained on 1000 orders!\")\n",
        "print(\"New Model Accuracy:\", round(new_accuracy * 100, 2), \"%\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "o8IV72aauHIV",
        "outputId": "7c81a8f6-51b8-413e-ad28-1042af9be14e"
      },
      "execution_count": 24,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Model retrained on 1000 orders!\n",
            "New Model Accuracy: 73.0 %\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Save and Download the Model"
      ],
      "metadata": {
        "id": "-0iukmkjug_B"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import joblib\n",
        "\n",
        "# Save the AI model\n",
        "joblib.dump(model_big, 'cancellation_model.pkl')\n",
        "\n",
        "# Save the column names (the website needs to know exactly what inputs to expect)\n",
        "joblib.dump(list(X_big.columns), 'model_columns.pkl')\n",
        "\n",
        "print(\"Model saved successfully!\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "B2JLjSJHumPQ",
        "outputId": "1f74901f-6665-421d-8fc8-5820e1df77de"
      },
      "execution_count": 25,
      "outputs": [
