    {
      "cell_type": "markdown",
      "source": [
        "STEP 13 — Add delivery_days Column"
      ],
      "metadata": {
        "id": "3SSE05joqJ2H"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "# 1 se 10 din tak random delivery time\n",
        "delivery_days = np.random.randint(1, 11, n)\n",
        "\n",
        "# Agar delivery time 6 din se zyada hai, toh cancellation ka chance barha do\n",
        "# (Yeh hum aapki insight ke mutabiq kar rahe hain)\n",
        "for i in range(n):\n",
        "    if delivery_days[i] > 6:\n",
        "        # 80% chance cancel ho jaye\n",
        "        df.loc[i, \"is_cancelled\"] = np.random.choice([0, 1], p=[0.2, 0.8])\n",
        "    elif delivery_days[i] > 3:\n",
        "        # 40% chance cancel ho jaye\n",
        "        df.loc[i, \"is_cancelled\"] = np.random.choice([0, 1], p=[0.6, 0.4])\n",
        "    else:\n",
        "        # 10% chance cancel ho jaye (fast delivery)\n",
        "        df.loc[i, \"is_cancelled\"] = np.random.choice([0, 1], p=[0.9, 0.1])\n",
        "\n",
        "# Add the new column to the table\n",
        "df[\"delivery_days\"] = delivery_days\n",
        "\n",
        "print(\"Delivery days column added!\")\n",
        "print(df[[\"delivery_days\", \"is_cancelled\"]].head())"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "hn0NQvQ4qPZ2",
        "outputId": "0ba797d8-54d3-4046-90c4-9b825d9f5c02"
      },
      "execution_count": 16,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Delivery days column added!\n",
            "   delivery_days  is_cancelled\n",
            "0              4             0\n",
            "1              8             1\n",
            "2              2             0\n",
            "3              3             0\n",
            "4              1             0\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "STEP 14 — Prove Your Theory"
      ],
      "metadata": {
        "id": "DeyK82lpqe1A"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "delivery_analysis = df.groupby(\"delivery_days\")[\"is_cancelled\"].mean() * 100\n",
        "print(\"Cancellation Rate by Delivery Days (%):\")\n",
        "print(delivery_analysis)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "okE6JqUkqiqj",
        "outputId": "a653b0ae-88d8-41d4-f271-d7c855f8332a"
      },
      "execution_count": 17,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Cancellation Rate by Delivery Days (%):\n",
            "delivery_days\n",
            "1     41.666667\n",
            "2      0.000000\n",
            "3     14.285714\n",
            "4     60.000000\n",
