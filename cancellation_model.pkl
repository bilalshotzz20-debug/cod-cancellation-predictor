    {
      "cell_type": "markdown",
      "source": [
        "STEP 18 — Train the Machine Learning Model"
      ],
      "metadata": {
        "id": "r7xvsrZLrtAj"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.ensemble import RandomForestClassifier\n",
        "\n",
        "# Model banaya\n",
        "model = RandomForestClassifier(random_state=42)\n",
        "\n",
        "# Model ko train kiya\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "print(\"Model training complete!\")\n",
        "print(\"The AI has learned from the data.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
