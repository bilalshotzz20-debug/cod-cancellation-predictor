          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "STEP 15 — Visualize Your Theory"
      ],
      "metadata": {
        "id": "G-pwgpQyqr47"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.plot(delivery_analysis.index, delivery_analysis.values, marker='o', color='red')\n",
        "plt.title(\"Impact of Delivery Days on Cancellation (Pakistan COD)\")\n",
        "plt.xlabel(\"Delivery Days\")\n",
        "plt.ylabel(\"Cancellation Rate (%)\")\n",
        "plt.grid(True)\n",
        "plt.show()"
      ],
      "metadata": {
